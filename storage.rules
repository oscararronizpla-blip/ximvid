rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: solo el propio usuario
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Fotos de portada (banner): solo el propio usuario
    match /bannerPhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Videos: el usuario solo puede escribir en su propia carpeta
    match /videos/{userId}/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 300 * 1024 * 1024;
    }

    // Thumbnails: el usuario solo puede escribir en su propia carpeta
    match /thumbnails/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024;
    }

    // Galeria de fotos: solo el propio usuario
    match /galleryPhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }
    // Fotos de producto (editar promociones): usuarios autenticados, max 15MB
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
