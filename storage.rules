rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: solo el propio usuario
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fotos de portada (banner): solo el propio usuario
    match /bannerPhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Videos: el usuario solo puede escribir en su propia carpeta
    match /videos/{userId}/{videoId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Thumbnails: el usuario solo puede escribir en su propia carpeta
    match /thumbnails/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Galeria de fotos: solo el propio usuario
    match /galleryPhotos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
