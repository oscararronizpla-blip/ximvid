{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/feed",
        "destination": "/feed.html"
      },
      {
        "source": "/upload",
        "destination": "/upload.html"
      },
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/settings",
        "destination": "/settings.html"
      },
      {
        "source": "/search",
        "destination": "/search.html"
      },
      {
        "source": "/stats",
        "destination": "/stats.html"
      },
      {
        "source": "/premium",
        "destination": "/premium.html"
      },
      {
        "source": "/notifications",
        "destination": "/notifications.html"
      },
      {
        "source": "/register",
        "destination": "/register.html"
      },
      {
        "source": "/welcome",
        "destination": "/welcome.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/moderation",
        "destination": "/moderation.html"
      },
      {
        "source": "/.well-known/**",
        "destination": "/.well-known/assetlinks.json"
      },
      {
        "source": "/**",
        "destination": "/landing.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://lh3.googleusercontent.com https://api.qrserver.com; media-src 'self' blob: https://firebasestorage.googleapis.com; frame-src https://ximvid-c8627.firebaseapp.com https://accounts.google.com https://*.firebaseapp.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://firebasestorage.googleapis.com https://*.cloudfunctions.net wss://*.firebaseio.com; worker-src blob:;"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}